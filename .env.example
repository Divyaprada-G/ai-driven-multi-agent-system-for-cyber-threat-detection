# ==============================================================================
# AI-DRIVEN MULTI-AGENT CYBER THREAT DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure values before starting production services.
# NEVER commit actual secrets or passwords to source control.

# --- SERVER & NETWORK BINDINGS ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- SECURITY & AUTHENTICATION SECRETS (SERVER-SIDE ONLY) ---
# Cryptographic secret used for signing and validating session tokens
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# Shared API key for authenticating edge telemetry collectors (Windows/Linux agents)
# Transmitted via 'x-api-key: <key>' or 'Authorization: Bearer <key>'
BACKEND_API_KEY=your_telemetry_collector_shared_api_key

# Pre-seeded account passwords for initial SOC system deployment
# Passwords must be at least 12 characters with upper, lower, number, and special chars
ADMIN_INITIAL_PASSWORD=Admin@SOC2026!#Secure
ANALYST_INITIAL_PASSWORD=Analyst@Cyber2026!
VIEWER_INITIAL_PASSWORD=Viewer@Auditor2026!

# Allowed CORS origins (comma-separated). Leave empty to use secure defaults.
# Defaults permit localhost, AI Studio preview, and Cloud Run hostnames.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ai.studio

# --- DATABASE CREDENTIALS ---
# MongoDB persistence URI (must use authenticated credentials in production)
MONGODB_URI=mongodb://soc_app:secure_mongo_password@127.0.0.1:27017/cyber_threat_detection?authSource=admin
MONGODB_DB_NAME=cyber_threat_detection

# Cloud SQL / PostgreSQL (drizzle-orm credentials)
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=cyber_threat_db
SQL_USER=soc_analyst
SQL_PASSWORD=secure_sql_password
SQL_ADMIN_USER=soc_admin
SQL_ADMIN_PASSWORD=secure_sql_admin_password
DATABASE_URL=postgresql://soc_analyst:secure_sql_password@127.0.0.1:5432/cyber_threat_db

# --- MACHINE LEARNING SERVICE PROXY ---
ML_SERVICE_URL=http://127.0.0.1:8000
PYTHON_ML_SERVICE_URL=http://127.0.0.1:8000

# --- SOAR & WORKFLOW NOTIFICATIONS ---
N8N_WEBHOOK_URL=https://n8n.internal.soc/webhook/cyber-threat-alert
NOTIFICATION_WEBHOOK_URL=https://soar.internal.soc/api/v1/alerts
NOTIFICATION_WEBHOOK_SECRET=your_hmac_webhook_verification_secret
NOTIFICATION_EMAIL_TO=soc-alerts@internal.soc
SMTP_HOST=smtp.internal.soc

# --- WINDOWS TELEMETRY COLLECTOR CONFIGURATION ---
BACKEND_API_URL=http://127.0.0.1:3000
COLLECTOR_HEALTH_PORT=8085
COLLECTION_INTERVAL_SEC=5.0
MAX_BATCH_SIZE=50
ENABLED_COLLECTORS=win_event_log,app_files,network
WIN_EVENT_CHANNELS=System,Application,Security
APP_LOG_DIRECTORIES=C:\inetpub\logs,C:\ProgramData\AppLogs,logs
APP_LOG_EXTENSIONS=.log,.txt,.json,.jsonl

# --- PLATFORM API KEYS (SERVER-SIDE ONLY) ---
GEMINI_API_KEY=
FIREBASE_API_KEY=
