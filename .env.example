# Cyber Threat Detection Platform Configuration
# Copy this file to .env or configure in deployment settings.

# Server & Network Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Python ML Microservice URL (Default local service)
ML_SERVICE_URL=http://127.0.0.1:8000

# Automated Incident Response (n8n Webhook Target)
N8N_WEBHOOK_URL=

# Optional Relational Database (PostgreSQL / Cloud SQL)
# When omitted, the platform runs in full local persistent JSON store mode.
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
